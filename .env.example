# Copy to .env (git-ignored) and fill in real values, then export them into your
# shell or IDE run configuration before starting the app.

# Zalo Official Account (developers.zalo.me)
ZALO_APP_ID=your-zalo-app-id
ZALO_APP_SECRET=your-zalo-app-secret
ZALO_OA_ID=your-zalo-oa-id
ZALO_REDIRECT_URI=http://localhost:8081/zalo/callback
# Optional: comma-separated Zalo user IDs polled by the scheduler
ZALO_SCHEDULED_USERS=

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# MySQL
DB_URL=jdbc:mysql://localhost:3306/zalobot?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=zalobot
DB_PASSWORD=change-me

# Optional
SERVER_PORT=8081
# Add "dev" to enable the /simulate endpoints, e.g. local,dev
SPRING_PROFILES_ACTIVE=local
